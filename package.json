{
  "name": "keitaro-ueki-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run dev:cloudflare",
    "dev:astro": "astro dev",
    "dev:cloudflare": "npm run build && npm run db:migrate:local && wrangler pages dev dist",
    "check": "astro check && npm run check:functions",
    "check:functions": "tsc --noEmit -p functions/tsconfig.json",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "db:migrate:local": "wrangler d1 migrations apply portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist",
    "audit:ui": "playwright test tools/ui-audit.spec.ts",
    "audit:site": "playwright test tools/site-quality.spec.ts --project=desktop",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.15.11",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@lucide/astro": "^0.552.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^5.18.2",
    "astro-expressive-code": "^0.41.7",
    "daisyui": "^5.3.10",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@playwright/test": "^1.56.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
