---
import { Plus } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Lang } from "../i18n/ui";
import SectionShell from "./layout/SectionShell.astro";
import SectionHeader from "./SectionHeader.astro";
import SkillBadge from "./SkillBadge.astro";

interface Props {
  title: string;
  photo?: ImageMetadata | string;
  Content: any;
  link?: string;
  skills?: string[];
}

const { title, photo, Content, link, skills = [] } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);
---

<SectionShell id="about" width="content">
  <SectionHeader label="About" subtitle={t("about.subtitle")} />

  <div class="profile-panel profile-panel--ink">
      {
        photo && (
          <figure class="profile-panel__media">
            <div>
              {typeof photo === "string" ? (
                <img
                  src={photo}
                  alt={title}
                />
              ) : (
                <Image
                  src={photo}
                  alt={title}
                />
              )}
            </div>
          </figure>
        )
      }
      <div class="profile-panel__content">
        <h3>{title}</h3>
        <article class="prose prose-base max-w-none">
          <Content />
        </article>
        {skills.length > 0 && (
          <div class="profile-panel__skills" aria-label={t("about.skills")}>
            {skills.map((skill) => <SkillBadge skill={skill} />)}
          </div>
        )}
        {
          link && (
            <div class="mt-6">
              <a
                href={
                  link.startsWith("http")
                    ? link
                    : `${import.meta.env.BASE_URL}${link.startsWith("/") ? link.slice(1) : link}`
                }
                target={link.startsWith("http") ? "_blank" : "_self"}
                class="btn btn-primary"
              >
                <Plus class="size-5" />
                {t("about.seeMore")}
              </a>
            </div>
          )
        }
      </div>
  </div>
</SectionShell>
