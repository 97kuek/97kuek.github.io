---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowRight, MapPin } from "@lucide/astro";
import { getIcon } from "../utils/iconMapper";

interface Props {
  hero: {
    name: string;
    alternateName?: string;
    title: string;
    profession?: string;
    description: string;
    avatar: ImageMetadata | string;
    location?: string;
    socialLinks: Array<{
      url: string;
      icon: string;
      label: string;
    }>;
  };
}

const { hero } = Astro.props;
const isEn = (Astro.currentLocale ?? "ja") === "en";
const primaryLinks = [
  {
    href: "#projects",
    label: isEn ? "View projects" : "プロジェクトを見る",
    primary: true,
  },
  {
    href: "#contact",
    label: isEn ? "Start a conversation" : "相談する",
    primary: false,
  },
];
---

<section class="hero-stage" aria-labelledby="hero-title">
  <div class="site-container hero-stage__grid" data-width="wide">
    <figure class="hero-portrait">
      {typeof hero.avatar === "string" ? (
        <img src={hero.avatar} alt={hero.name} fetchpriority="high" />
      ) : (
        <Image src={hero.avatar} alt={hero.name} loading="eager" fetchpriority="high" />
      )}
    </figure>

    <div class="hero-copy">
      <h1 id="hero-title">{hero.name}</h1>
      {hero.alternateName && hero.alternateName !== hero.name && (
        <p class="hero-copy__alternate">{hero.alternateName}</p>
      )}

      <p class="hero-copy__role">{hero.title}</p>
      {hero.profession && <p class="hero-copy__profession">{hero.profession}</p>}

      {hero.location && (
        <p class="hero-copy__location">
          <MapPin aria-hidden="true" />
          {hero.location}
        </p>
      )}

      <p class="hero-copy__description">{hero.description.trim()}</p>

      <div class="hero-actions">
        {primaryLinks.map((link) => (
          <a href={link.href} class:list={["btn", link.primary ? "btn-primary" : "btn-ghost"]}>
            {link.label}
            <ArrowRight aria-hidden="true" />
          </a>
        ))}
      </div>

      <nav class="hero-socials" aria-label={isEn ? "Social links" : "ソーシャルリンク"}>
        {hero.socialLinks.map((link) => {
          const Icon = getIcon(link.icon);
          return (
            <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
              <Icon aria-hidden="true" />
              <span>{link.label}</span>
            </a>
          );
        })}
      </nav>
    </div>
  </div>

</section>
