---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getIcon } from "../utils/iconMapper";
import { MapPin } from "@lucide/astro";
import {
  HERO_STREAM_BASE_DELAY_MS,
  HERO_STREAM_RANDOM_DELAY_MS,
} from "../utils/constants";

interface Props {
  hero: {
    name: string;
    title: string;
    description: string;
    avatar: ImageMetadata | string;
    location?: string;
    socialLinks: Array<{
      url: string;
      icon: string;
      label: string;
    }>;
  };
}

const { hero } = Astro.props;
const isEn = (Astro.currentLocale ?? "ja") === "en";
const primaryLinks = [
  { href: "#projects", label: isEn ? "View projects" : "プロジェクトを見る", variant: "btn-primary" },
  { href: "#contact", label: isEn ? "Contact" : "連絡する", variant: "btn-ghost" },
];
---

<section class="hero min-h-[100dvh]">
  <div class="hero-content flex-col lg:flex-row-reverse max-w-7xl w-full gap-8 lg:gap-20 pt-24 pb-12 md:pt-28 md:pb-16">

    <!-- Avatar -->
    <div class="shrink-0">
      <div class="w-44 sm:w-52 lg:w-64 rounded-full overflow-hidden ring-2 ring-primary/20 ring-offset-2">
        {
          typeof hero.avatar === "string" ? (
            <img src={hero.avatar} alt={hero.name} class="w-full h-full object-cover" fetchpriority="high" />
          ) : (
            <Image src={hero.avatar} alt={hero.name} class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
          )
        }
      </div>
    </div>

    <!-- Text content -->
    <div class="max-w-2xl text-center lg:text-left">
      <h1 class="text-4xl lg:text-6xl font-bold tracking-tight mb-3 leading-[1.1] text-base-content">
        {hero.name}
      </h1>

      <p class="text-xl text-base-content/70 mb-2 font-medium">
        {
          hero.title.split(" / ").map((part, i) => (
            <>
              {i > 0 && <span class="text-base-content/35 mx-0.5" aria-hidden="true">/</span>}
              <span class="inline-block">{part}</span>
            </>
          ))
        }
      </p>

      {
        hero.location && (
          <p class="text-base-content/50 mb-5 flex items-center gap-1.5 justify-center lg:justify-start text-sm">
            <MapPin class="size-3.5" aria-hidden="true" />
            {hero.location}
          </p>
        )
      }

      <p
        class="text-base leading-relaxed mb-6 text-base-content/75 whitespace-pre-line phrase-wrap"
        data-hero-desc
      >{hero.description.trim()}<span class="hero-cursor" aria-hidden="true">▋</span></p>

      <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-6">
        {
          primaryLinks.map((link) => (
            <a href={link.href} class={`btn btn-sm sm:btn-md ${link.variant}`}>
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Social links -->
      <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
        {
          hero.socialLinks.map((link) => {
            const IconComponent = getIcon(link.icon);
            return (
              <div class="tooltip tooltip-top" data-tip={link.label}>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-circle btn-ghost hover:btn-primary hover:scale-110 transition-all duration-200"
                  aria-label={link.label}
                >
                  <IconComponent class="size-6" />
                </a>
              </div>
            );
          })
        }
      </div>

    </div>
  </div>
</section>

<style>
  .hero-cursor {
    display: inline-block;
    margin-left: 0.1em;
    font-weight: 400;
    color: var(--color-primary);
    transform: translateY(0.04em);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-cursor {
      animation: hero-blink 1.1s step-end infinite;
    }
  }
  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script is:inline define:vars={{ HERO_STREAM_BASE_DELAY_MS, HERO_STREAM_RANDOM_DELAY_MS }}>
  document.addEventListener("astro:page-load", function () {
    var el = document.querySelector("[data-hero-desc]");
    if (!el || el.dataset.streamed === "done") return;

    var reduce =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var textNode = el.firstChild;
    // Trim so a trailing YAML newline can't push the cursor onto its own line
    // (the text sits in a whitespace-pre-line paragraph).
    var full = textNode && textNode.nodeType === 3 ? textNode.textContent.trim() : "";
    el.dataset.streamed = "done";

    // Reduced motion or empty: leave the server-rendered text as-is.
    if (reduce || !full) return;

    // Lock height first to prevent layout shift while the text streams in.
    el.style.minHeight = el.offsetHeight + "px";

    var typed = document.createElement("span");
    textNode.replaceWith(typed);

    // Tokenize into words. Japanese has no spaces, so prefer Intl.Segmenter
    // (word granularity) and fall back to "leading whitespace + word" chunks;
    // either way the cursor stays glued to the last token between ticks.
    var tokens;
    if (window.Intl && Intl.Segmenter) {
      tokens = Array.from(
        new Intl.Segmenter("ja", { granularity: "word" }).segment(full),
        function (s) { return s.segment; }
      );
    } else {
      tokens = full.match(/\s*\S+/g) || [full];
    }
    var i = 0;
    function step() {
      if (i >= tokens.length) return;
      typed.textContent += tokens[i++];
      setTimeout(step, HERO_STREAM_BASE_DELAY_MS + Math.random() * HERO_STREAM_RANDOM_DELAY_MS);
    }
    step();
  });
</script>
