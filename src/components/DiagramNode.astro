---
const { label, sublabel, color = 'default' } = Astro.props;

const colorMap: Record<string, string> = {
  primary:   'bg-base-100 border-primary/55 text-base-content',
  secondary: 'bg-base-100 border-secondary/55 text-base-content',
  accent:    'bg-base-100 border-accent/60 text-base-content',
  success:   'bg-base-100 border-success/55 text-base-content',
  warning:   'bg-base-100 border-warning/65 text-base-content',
  error:     'bg-base-100 border-error/55 text-base-content',
};
const boxClass = colorMap[color] ?? 'bg-base-100 border-base-content/25 text-base-content';
---

<span class="diagram-node-outer">
  <span class={`diagram-node-box inline-block px-4 py-2.5 rounded-lg border-2 text-center min-w-[6rem] ${boxClass}`}>
    <span class="block font-semibold text-sm leading-tight">{label}</span>
    {sublabel && <span class="block text-xs text-base-content/65 mt-0.5">{sublabel}</span>}
    <slot />
  </span>
</span>
