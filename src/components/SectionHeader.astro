---
const {
  label,
  subtitle,
  class: className = "",
  subtitleClass = "section-heading__subtitle phrase-wrap",
  as = "h2",
} = Astro.props;
const Heading = as;
---

<div class:list={["section-heading", className]}>
  <div class="section-heading__title-row">
    <Heading class="section-heading__title">{label}</Heading>
  </div>
  {subtitle && <p class={subtitleClass}>{subtitle}</p>}
</div>
