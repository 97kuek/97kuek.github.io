---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { ArrowRight } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";
import SectionHeader from "./SectionHeader.astro";
import { getFeaturedProjects, getProjectsUrl } from "../utils/content";
import { PROJECT_MARQUEE_SPEED_PX_PER_SEC } from "../utils/constants";
import SectionShell from "./layout/SectionShell.astro";

const projectEntries = await getCollection("projects");

const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);
const projectsBase = getProjectsUrl(locale);
const featuredProjects = getFeaturedProjects(projectEntries, projectEntries.length);
---

<SectionShell id="projects" width="wide" tone="wash">
    <SectionHeader label="Projects" subtitle={t("projects.subtitle")} />

    {
      featuredProjects.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg text-base-content/60">
            {t("projects.noFeatured")}
          </p>
        </div>
      ) : (
        <div
          class="project-marquee"
          data-project-marquee
          data-marquee-speed={PROJECT_MARQUEE_SPEED_PX_PER_SEC}
          role="group"
          aria-label={t("projects.subtitle")}
          tabindex="0"
        >
          {/*
            Cards sit directly in the track — one flat flex row, no per-pass
            wrapper. A nested flex container gets an oversized intrinsic width
            in WebKit, which showed up as dead space at the end of every pass.
            The second pass is what the scroll offset wraps onto.
          */}
          <div class="project-marquee__track">
            {featuredProjects.map((project) => (
              <div class="project-marquee__item">
                <ProjectCard project={project} variant="gallery" />
              </div>
            ))}
            {featuredProjects.map((project) => (
              <div class="project-marquee__item" aria-hidden="true" data-marquee-clone>
                <ProjectCard project={project} variant="gallery" />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="section-action">
      <a href={projectsBase} class="btn btn-primary btn-outline gap-2">
        {t("projects.seeAll")}
        <ArrowRight class="size-4" />
      </a>
    </div>
</SectionShell>

<script>
  import "../scripts/project-marquee";
</script>
