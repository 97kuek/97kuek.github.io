---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { ArrowRight } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";
import SectionHeader from "./SectionHeader.astro";
import { getFeaturedProjects, getProjectsUrl } from "../utils/content";
import SectionShell from "./layout/SectionShell.astro";

const projectEntries = await getCollection("projects");

const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);
const projectsBase = getProjectsUrl(locale);
const featuredProjects = getFeaturedProjects(projectEntries);
---

<SectionShell id="projects" width="wide" tone="wash">
    <SectionHeader label="Projects" subtitle={t("projects.subtitle")} />

    {
      featuredProjects.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg text-base-content/60">
            {t("projects.noFeatured")}
          </p>
        </div>
      ) : (
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }

    <div class="section-action">
      <a href={projectsBase} class="btn btn-primary btn-outline gap-2">
        {t("projects.seeAll")}
        <ArrowRight class="size-4" />
      </a>
    </div>
</SectionShell>
