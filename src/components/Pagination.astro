---
import { useTranslations, type Lang } from "../i18n/ui";
import { ChevronLeft, ChevronRight } from "@lucide/astro";

interface Props {
  currentPage: number;
  lastPage: number;
  /** List page path without trailing slash, e.g. `${import.meta.env.BASE_URL}blog` */
  basePath: string;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, basePath, prevUrl, nextUrl } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);

const pageHref = (n: number) => (n === 1 ? basePath : `${basePath}/${n}`);

function buildPages(current: number, last: number): Array<number | "ellipsis"> {
  const keep = new Set([1, last, current - 1, current, current + 1]);
  const sorted = [...keep].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  const result: Array<number | "ellipsis"> = [];
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev > 1) result.push("ellipsis");
    result.push(n);
    prev = n;
  }
  return result;
}

const pages = buildPages(currentPage, lastPage);
---

{
  lastPage > 1 && (
    <nav class="mt-12 flex justify-center" aria-label={t("pagination.aria")}>
      <div class="join">
        {prevUrl ? (
          <a href={prevUrl} class="join-item btn btn-sm" aria-label={t("pagination.prev")}>
            <ChevronLeft class="size-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">
            <ChevronLeft class="size-4" />
          </span>
        )}

        {pages.map((p) =>
          p === "ellipsis" ? (
            <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">
              …
            </span>
          ) : (
            <a
              href={pageHref(p)}
              class:list={[
                "join-item btn btn-sm",
                p === currentPage && "btn-primary pointer-events-none",
              ]}
              aria-label={t("pagination.page").replace("{n}", String(p))}
              aria-current={p === currentPage ? "page" : undefined}
            >
              {p}
            </a>
          ),
        )}

        {nextUrl ? (
          <a href={nextUrl} class="join-item btn btn-sm" aria-label={t("pagination.next")}>
            <ChevronRight class="size-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">
            <ChevronRight class="size-4" />
          </span>
        )}
      </div>
    </nav>
  )
}
