---
import { getCollection } from "astro:content";
import { BookOpenText, Braces, FolderKanban, UsersRound } from "@lucide/astro";
import SectionHeader from "./SectionHeader.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { getExternalArticles } from "../utils/externalArticles";

const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);

const [projects, localPosts, externalPosts] = await Promise.all([
  getCollection("projects"),
  getCollection("blog"),
  getExternalArticles(),
]);

const items = [
  {
    icon: FolderKanban,
    value: `${projects.length}`,
    label: t("highlights.projects"),
    text: t("highlights.projectsText"),
  },
  {
    icon: BookOpenText,
    value: `${localPosts.length + externalPosts.length}`,
    label: t("highlights.writing"),
    text: t("highlights.writingText"),
  },
  {
    icon: Braces,
    value: "4",
    label: t("highlights.focus"),
    text: t("highlights.focusText"),
  },
  {
    icon: UsersRound,
    value: "60+",
    label: t("highlights.team"),
    text: t("highlights.teamText"),
  },
];
---

<section id="highlights" class="py-16 px-4 bg-base-100">
  <div class="max-w-6xl mx-auto">
    <SectionHeader label={t("highlights.sectionLabel")} subtitle={t("highlights.subtitle")} />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        items.map((item) => {
          const Icon = item.icon;
          return (
            <article class="border border-base-200 bg-base-100 rounded-lg p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-3xl font-bold text-base-content">{item.value}</p>
                  <h3 class="mt-2 text-sm font-bold tracking-widest uppercase text-primary">{item.label}</h3>
                </div>
                <Icon class="size-6 text-secondary shrink-0" aria-hidden="true" />
              </div>
              <p class="mt-4 text-sm leading-relaxed text-base-content/70">{item.text}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
