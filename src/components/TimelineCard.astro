---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { ExternalLink } from "@lucide/astro";
import SkillBadge from "./SkillBadge.astro";
import { FLAT_CARD_CLASS } from "../utils/classes";

type TimelineEntry = CollectionEntry<"work"> | CollectionEntry<"education">;

interface Props {
  entry: TimelineEntry;
  Content: any;
  period: string;
  duration: string | null;
  color: string;
  icon: any;
  linkLabel: string;
  isFirst: boolean;
  isLast: boolean;
}

const { entry, Content, period, duration, color, icon, linkLabel, isFirst, isLast } =
  Astro.props;
const IconComponent = icon;
const skills = "skills" in entry.data ? entry.data.skills ?? [] : [];
const location = "location" in entry.data ? entry.data.location : undefined;
---

<li data-filter-tags={skills.join(",")}>
  {!isFirst && <hr class="bg-base-100" />}
  <div class="timeline-middle">
    <IconComponent class="size-5 mx-3 my-1" style={`color: var(--color-${color})`} />
  </div>
  <div class="timeline-end max-w-lg pt-3 mb-10">
    <time class="font-mono text-sm text-base-content/70 block italic">
      {period}
      {duration && <span class="ml-1 text-base-content/50">{duration}</span>}
    </time>
    <div class={`${FLAT_CARD_CLASS} mt-2`}>
      <div class="card-body gap-3">
        <div class="flex items-start gap-3">
          {entry.data.logo && (
            <div class="avatar shrink-0">
              <div class="w-11 mask mask-squircle">
                <Image src={entry.data.logo} alt={entry.data.title} inferSize={true} />
              </div>
            </div>
          )}
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="font-bold text-base leading-snug">{entry.data.title}</h3>
                <p class="font-semibold text-sm mt-0.5" style={`color: var(--color-${color})`}>
                  {entry.data.subtitle}
                </p>
                {location && <p class="text-xs text-base-content/50 mt-0.5">{location}</p>}
              </div>
              {entry.data.link && (
                <a
                  href={entry.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost btn-sm gap-1 shrink-0 mt-0.5"
                >
                  <ExternalLink class="size-3" />
                  <span class="hidden sm:inline text-xs">{linkLabel}</span>
                </a>
              )}
            </div>
          </div>
        </div>

        {skills.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {skills.map((skill: string) => <SkillBadge skill={skill} />)}
          </div>
        )}

        <div class="prose prose-sm max-w-none text-base-content/80">
          <Content />
        </div>
      </div>
    </div>
  </div>
  {!isLast && <hr class="bg-base-100" />}
</li>

