---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import SkillBadge from "./SkillBadge.astro";

type TimelineEntry = CollectionEntry<"work"> | CollectionEntry<"education">;

interface Props {
  entry: TimelineEntry;
  Content: any;
  period: string;
  duration: string | null;
  color: string;
  icon: any;
  linkLabel: string;
  isFirst: boolean;
  isLast: boolean;
}

const { entry, Content, period, duration, icon, linkLabel } = Astro.props;
const Icon = icon;
const skills = "skills" in entry.data ? entry.data.skills ?? [] : [];
const location = "location" in entry.data ? entry.data.location : undefined;
---

<li class="experience-entry" data-filter-tags={skills.join(",")}>
  <div class="experience-entry__meta">
    <span class="experience-entry__icon"><Icon aria-hidden="true" /></span>
    <time>{period}</time>
    {duration && <span>{duration}</span>}
  </div>

  <article class="experience-entry__body">
    <header>
      {entry.data.logo && (
        <div class="experience-entry__logo">
          <Image src={entry.data.logo} alt="" inferSize={true} />
        </div>
      )}
      <div>
        <p class="experience-entry__subtitle">{entry.data.subtitle}</p>
        <h3>{entry.data.title}</h3>
        {location && <p class="experience-entry__location">{location}</p>}
      </div>
      {entry.data.link && (
        <a
          href={entry.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="experience-entry__link"
        >
          <span>{linkLabel}</span>
          <ArrowUpRight aria-hidden="true" />
        </a>
      )}
    </header>

    <div class="prose prose-sm max-w-none text-base-content/80">
      <Content />
    </div>

    {skills.length > 0 && (
      <div class="experience-entry__skills">
        {skills.map((skill: string) => <SkillBadge skill={skill} />)}
      </div>
    )}
  </article>
</li>
