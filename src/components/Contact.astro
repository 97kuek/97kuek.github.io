---
import { getEntry, render } from "astro:content";
import { getIcon } from "../utils/iconMapper";
import { useTranslations, type Lang } from "../i18n/ui";

const locale = (Astro.currentLocale ?? "ja") as Lang;
const contactId = locale === "en" ? "en" : "index";
const contactEntry = (await getEntry("contact", contactId as "index"))!;
const contact = contactEntry.data;
const { Content } = await render(contactEntry);
const SectionIcon = getIcon(contact.icon);
const FooterIcon = getIcon(contact.footerIcon);
const t = useTranslations(locale);
const contactEmail = contact.linkUrl.replace(/^mailto:/, "");
---

<footer id="contact" class="home-section contact-stage" data-chapter="06">
  <div class="site-container" data-width="content">
    <h2 class="sr-only">{t("nav.contact")}</h2>

    <div class="contact-stage__grid" data-reveal>
      <section class="contact-stage__intro">
        <SectionIcon aria-hidden="true" />
        <div class="prose max-w-none text-base-content/75">
          <Content />
        </div>
        <a href={contact.linkUrl}>{contactEmail}</a>
      </section>

      <form
        class="contact-form"
        data-contact-form
        data-endpoint="/api/contact"
        data-locale={locale}
        data-sending={t("contact.sending")}
        data-success={t("contact.success")}
        data-error={t("contact.error")}
      >
        <input
          name="website"
          type="text"
          class="contact-form__honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div>
          <label for="contact-name">{t("contact.name")}</label>
          <input id="contact-name" name="name" type="text" required maxlength="80" autocomplete="name" />
        </div>
        <div>
          <label for="contact-email">{t("contact.email")}</label>
          <input id="contact-email" name="email" type="email" required maxlength="254" autocomplete="email" />
        </div>
        <div>
          <label for="contact-subject">{t("contact.subject")}</label>
          <input id="contact-subject" name="subject" type="text" required maxlength="120" />
        </div>
        <div>
          <label for="contact-message">{t("contact.message")}</label>
          <textarea id="contact-message" name="message" required minlength="10" maxlength="5000" rows="5"></textarea>
        </div>
        <div class="contact-form__footer">
          <button type="submit" class="btn btn-primary">{t("contact.submit")}</button>
          <p data-contact-status aria-live="polite"></p>
        </div>
      </form>
    </div>

    <div class="site-footer__meta">
      <span>Copyright &copy; {new Date().getFullYear()} — {contact.footerText}</span>
      <a href={contact.footerLinkUrl} target="_blank" rel="noopener noreferrer">
        <FooterIcon aria-hidden="true" />
        {contact.footerLinkText}
      </a>
    </div>
  </div>
</footer>

<script>
  import "../scripts/contact";
</script>
