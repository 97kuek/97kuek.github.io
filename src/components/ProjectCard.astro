---
import { Image } from "astro:assets";
import SkillBadge from "./SkillBadge.astro";
import OgPlaceholder from "./OgPlaceholder.astro";
import CardCarousel from "./CardCarousel.astro";
import { ExternalLink } from "@lucide/astro";
import GitHubIcon from "./icons/GitHub.astro";
import type { CollectionEntry } from "astro:content";
import { formatPeriod } from "../utils/formatDate";
import { useTranslations, type Lang } from "../i18n/ui";
import { GLASS_CARD_CLASS } from "../utils/classes";
import { getLocalizedProject, getProjectDetailUrl, getProjectsUrl } from "../utils/content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);
const {
  title: displayTitle,
  description: displayDescription,
  role,
  impact,
  status,
} = getLocalizedProject(project, locale);
const projectUrl = getProjectDetailUrl(project.id, locale);
const projectsListUrl = getProjectsUrl(locale);
const filterDate = project.data.endDate?.getTime() ?? Number.MAX_SAFE_INTEGER;
---

<article
  class={`${GLASS_CARD_CLASS} relative`}
  data-filter-tags={project.data.skills.join(",")}
  data-filter-title={displayTitle}
  data-filter-description={displayDescription}
  data-filter-date={filterDate}
>
  <figure class="aspect-video overflow-hidden">
    {project.data.images && project.data.images.length > 1 ? (
      <CardCarousel images={project.data.images} alt={project.data.title} />
    ) : project.data.image ? (
      <Image
        src={project.data.image}
        alt={project.data.title}
        class="w-full h-full object-cover"
        width={600}
        height={400}
      />
    ) : (
      <OgPlaceholder id={project.id} title={displayTitle} label="PROJECT" minimal={true} />
    )}
  </figure>
  <div class="card-body">
    <h3 class="card-title group-hover:text-primary transition-colors">
      <a
        href={projectUrl}
        class="after:absolute after:inset-0 after:content-[''] hover:text-primary transition-colors"
      >{displayTitle}</a>
    </h3>
    <time class="text-sm text-base-content/60">
      {formatPeriod(project.data.startDate, project.data.endDate)}
    </time>
    {(role || impact || status) && (
      <dl class="grid gap-2 text-sm">
        {role && (
          <div class="flex gap-2">
            <dt class="min-w-12 font-semibold text-primary">{t("project.role")}</dt>
            <dd class="text-base-content/75">{role}</dd>
          </div>
        )}
        {impact && (
          <div class="flex gap-2">
            <dt class="min-w-12 font-semibold text-primary">{t("project.impact")}</dt>
            <dd class="text-base-content/75">{impact}</dd>
          </div>
        )}
        {status && (
          <div class="flex gap-2">
            <dt class="min-w-12 font-semibold text-primary">{t("project.status")}</dt>
            <dd class="text-base-content/75">{status}</dd>
          </div>
        )}
      </dl>
    )}
    <p class="text-base-content/80">{displayDescription}</p>
    <div class="flex flex-wrap gap-2 mt-2">
      {
        project.data.skills.map((skill) => (
          <SkillBadge
            skill={skill}
            href={`${projectsListUrl}?tag=${encodeURIComponent(skill.toLowerCase())}`}
          />
        ))
      }
    </div>
    <div class="card-actions justify-end mt-4 gap-2 relative z-10">
      {
        project.data.demoLink && (
          <a
            href={project.data.demoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-soft gap-1"
          >
            <ExternalLink class="size-4" />
            {t("project.viewDemo")}
          </a>
        )
      }
      {
        project.data.sourceLink && (
          <a
            href={project.data.sourceLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-soft gap-1"
          >
            <GitHubIcon class="size-4" aria-hidden="true" />
            {t("project.sourceCode")}
          </a>
        )
      }
    </div>
  </div>
</article>
