---
import { ArrowRight, GitPullRequest, Star } from "@lucide/astro";
import SectionHeader from "./SectionHeader.astro";
import GitHubIcon from "./icons/GitHub.astro";
import { FLAT_CARD_CLASS } from "../utils/classes";
import { SITE } from "../utils/site";
import { useTranslations, type Lang } from "../i18n/ui";

const USERNAME = SITE.githubUsername;
const PROFILE_URL = `https://github.com/${USERNAME}`;

const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);
---

<section id="github" class="py-16 px-4 bg-base-200">
  <div class="max-w-6xl mx-auto">
    <SectionHeader
      label="GITHUB"
      subtitle={t("github.subtitle")}
      subtitleClass="text-base text-base-content/60"
    />

    <div
      class={FLAT_CARD_CLASS}
    >
      <div class="card-body">
        <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <GitHubIcon class="size-8 text-base-content" aria-hidden="true" />
              <h3 class="text-2xl font-bold">@{USERNAME}</h3>
            </div>
            <p class="text-base-content/70">
              {t("github.description")}
            </p>
          </div>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-lg border border-base-200 p-4">
              <GitPullRequest class="size-5 text-secondary mb-2" aria-hidden="true" />
              <p class="font-semibold">{t("github.codeHistory")}</p>
            </div>
            <div class="rounded-lg border border-base-200 p-4">
              <Star class="size-5 text-secondary mb-2" aria-hidden="true" />
              <p class="font-semibold">{t("github.publicRepos")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-12">
      <a
        href={PROFILE_URL}
        target="_blank"
        rel="noopener"
        class="btn btn-primary btn-outline gap-2"
      >
        <GitHubIcon class="size-4" aria-hidden="true" />
        {t("github.view")}
        <ArrowRight class="size-4" />
      </a>
    </div>
  </div>
</section>
