---
import { ChevronRight } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";

const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);
const { label = t("details.showCode") } = Astro.props;
---

<details class="details-block not-prose my-6 group">
  <summary class="cursor-pointer select-none list-none flex items-center gap-2 text-sm font-mono px-4 py-2.5 rounded-lg group-open:rounded-b-none bg-[var(--terminal-border)] text-[var(--terminal-muted)] hover:text-[var(--terminal-text)] transition-colors border border-[var(--terminal-border-soft)] group-open:border-b-0">
    <ChevronRight class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" aria-hidden="true" />
    <span class="group-open:hidden">{label}</span>
    <span class="hidden group-open:inline">{t("details.close")}</span>
  </summary>
  <slot />
</details>

<style is:global>
  /* EC の空ヘッダーバーを非表示 */
  .details-block .expressive-code figcaption.header {
    display: none;
  }
  /* サマリーと連続させるためトップの border / radius を除去 */
  .details-block .expressive-code pre {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top: none;
  }
  /* EC ブロック自体のマージンをリセット */
  .details-block .expressive-code {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
