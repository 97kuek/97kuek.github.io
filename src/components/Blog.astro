---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";
import { ArrowRight } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";
import SectionHeader from "./SectionHeader.astro";
import { FEATURED_BLOG_TOPIC_LIMIT, LATEST_POST_LIMIT } from "../utils/constants";
import { getTagSummary } from "../utils/content";
import { getExternalArticles } from "../utils/externalArticles";

const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);

const blogEntries = await getCollection("blog");
const externalArticles = await getExternalArticles();

const sortedPosts = blogEntries.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const latestItems = [
  ...sortedPosts.map((post) => ({ type: "local" as const, date: post.data.publishDate, post })),
  ...externalArticles.map((article) => ({ type: "external" as const, date: article.publishedAt, article })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, LATEST_POST_LIMIT);
const { tags: featuredTopics, tagCounts } = getTagSummary(
  [...blogEntries, ...externalArticles],
  (item) => "source" in item ? item.tags : item.data.tags,
);
---

<section id="blog" class="py-16 px-4 bg-base-200">
  <div class="max-w-6xl mx-auto">
    <SectionHeader label={t("blog.sectionLabel")} subtitle={t("blog.subtitle")} />

    {featuredTopics.length > 0 && (
      <div class="mb-8 flex flex-wrap items-center justify-center gap-2 text-sm">
        <span class="font-semibold text-base-content/50 mr-1">{t("blog.featuredTopics")}</span>
        {featuredTopics.slice(0, FEATURED_BLOG_TOPIC_LIMIT).map((tag) => (
          <a
            href={`${import.meta.env.BASE_URL}blog/tags/${tag}`}
            class="badge badge-outline badge-secondary hover:badge-secondary hover:text-secondary-content transition-colors"
          >
            {tag}
            <span class="opacity-70">({tagCounts[tag]})</span>
          </a>
        ))}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestItems.map((item) => (
        item.type === "local"
          ? <BlogCard post={item.post} />
          : <BlogCard article={item.article} />
      ))}
    </div>

    <div class="text-center mt-12">
      <a href={`${import.meta.env.BASE_URL}blog`} class="btn btn-primary btn-outline gap-2">
        {t("blog.seeAll")}
        <ArrowRight class="size-4" />
      </a>
    </div>
  </div>
</section>
