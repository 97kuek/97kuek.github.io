---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";
import { ArrowRight } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";
import SectionHeader from "./SectionHeader.astro";
import { LATEST_POST_LIMIT } from "../utils/constants";
import { getExternalArticles } from "../utils/externalArticles";
import SectionShell from "./layout/SectionShell.astro";

const t = useTranslations((Astro.currentLocale ?? "ja") as Lang);

const blogEntries = await getCollection("blog");
const externalArticles = await getExternalArticles();

const sortedPosts = blogEntries.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const latestItems = [
  ...sortedPosts.map((post) => ({ type: "local" as const, date: post.data.publishDate, post })),
  ...externalArticles.map((article) => ({ type: "external" as const, date: article.publishedAt, article })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, LATEST_POST_LIMIT);
---

<SectionShell id="blog" width="wide">
    <SectionHeader label={t("blog.sectionLabel")} subtitle={t("blog.subtitle")} />

    <div class="editorial-grid">
      {latestItems.map((item) => (
        item.type === "local"
          ? <BlogCard post={item.post} />
          : <BlogCard article={item.article} />
      ))}
    </div>

    <div class="section-action">
      <a href={`${import.meta.env.BASE_URL}blog`} class="btn btn-primary btn-outline gap-2">
        {t("blog.seeAll")}
        <ArrowRight class="size-4" />
      </a>
    </div>
</SectionShell>
