---
import { getEntry } from "astro:content";
import { useTranslations, type Lang } from "../i18n/ui";
import { Menu, Search } from "@lucide/astro";
import {
  NAVBAR_SCROLL_THRESHOLD_PX,
  NAVBAR_SECTION_OFFSET_PX,
} from "../utils/constants";

const heroEntry = await getEntry("hero", "index");
const name = heroEntry?.data?.name ?? "Portfolio";

const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;
const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);

const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const isHome =
  pathname === base ||
  pathname === normalizedBase ||
  pathname === "/" ||
  pathname === "/en" ||
  pathname === "/en/";

const normalizePath = (value: string) => {
  const pathOnly = value.split("#")[0].split("?")[0];
  const withSlash = pathOnly.endsWith("/") ? pathOnly : `${pathOnly}/`;
  return withSlash === "//" ? "/" : withSlash;
};

const currentPath = normalizePath(pathname);

const homeNavLinks = [
  { href: "#projects", label: t("nav.projects"), key: "projects" },
  ...(locale === "ja" ? [{ href: "#blog", label: t("nav.blog"), key: "blog" }] : []),
  { href: "#contact", label: t("nav.contact"), key: "contact" },
];

const nonHomeNavLinks = [
  { href: locale === "en" ? "/en/" : base, label: t("nav.home"), key: "home" },
  { href: locale === "en" ? `${base}en/projects` : `${base}projects`, label: t("nav.projects"), key: "projects" },
  ...(locale === "ja" ? [{ href: `${base}blog`, label: t("nav.blog"), key: "blog" }] : []),
  { href: locale === "en" ? "/en/#contact" : `${base}#contact`, label: t("nav.contact"), key: "contact" },
];

const navLinks = isHome ? homeNavLinks : nonHomeNavLinks;

const langToggleHref = locale === "en" ? "/" : "/en/";
const searchHref = locale === "en" ? `${base}en/search` : `${base}search`;

const isActiveHref = (href: string) => {
  if (isHome || href.startsWith("#")) return false;
  const target = normalizePath(href);
  if (target === "/" || target === "/en/") return currentPath === target;
  return currentPath === target || currentPath.startsWith(target);
};
const isSearchActive = currentPath === normalizePath(searchHref);
---

<header
  id="site-navbar"
  class="fixed top-0 left-0 right-0 z-40 navbar bg-base-100/60 backdrop-blur-xl backdrop-saturate-150 transition-[background-color,box-shadow] duration-200"
  data-scroll-threshold={NAVBAR_SCROLL_THRESHOLD_PX}
  data-section-offset={NAVBAR_SECTION_OFFSET_PX}
>
  <div class="navbar-start">
    <a href={locale === "en" ? "/en/" : base} data-nav-key="brand" class="btn btn-ghost font-bold text-base">{name}</a>
  </div>

  <div class="navbar-end">
    <!-- デスクトップ: 横並びリンク -->
    <nav class="hidden lg:flex gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-key={link.key}
          aria-current={isActiveHref(link.href) ? "page" : undefined}
          data-active={isActiveHref(link.href) ? "" : undefined}
          class="btn btn-ghost btn-sm font-medium text-base-content/90 hover:text-base-content hover:bg-base-content/5 data-[active]:text-primary data-[active]:font-semibold"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- 言語トグル -->
    <a
      href={langToggleHref}
      data-nav-key="lang"
      class="btn btn-sm font-mono text-xs bg-base-100/80 border-base-300 hover:border-primary/40 ml-1"
      aria-label={t("lang.switchLabel")}
    >
      {t("lang.switchTo")}
    </a>

    <!-- 検索ボタン -->
    <a
      href={searchHref}
      data-nav-key="search"
      class:list={[
        "btn btn-square btn-sm bg-base-100/80 border-base-300 hover:border-primary/40 ml-1",
        isSearchActive && "text-primary",
      ]}
      aria-label={t("nav.search")}
      aria-current={isSearchActive ? "page" : undefined}
    >
      <Search class="size-[18px]" aria-hidden="true" />
    </a>

    <!-- モバイル・タブレット: ハンバーガー -->
    <div class="dropdown dropdown-end lg:hidden">
      <button tabindex="0" class="btn btn-square bg-base-100/80 border-base-300 ml-1" aria-label={t("nav.openMenu")}>
        <Menu class="size-[22px]" aria-hidden="true" />
      </button>
      <ul
        tabindex="0"
        class="dropdown-content menu glass-card rounded-box z-50 w-48 p-2 mt-2"
      >
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-key={link.key}
              class:list={[
                "text-base-content/80",
                isActiveHref(link.href) && "text-primary font-semibold",
              ]}
              aria-current={isActiveHref(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={langToggleHref} data-nav-key="lang" class="text-base-content/80 font-mono text-xs">
            {t("lang.switchTo")}
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const initNavbar = () => {
    const navbar = document.getElementById('site-navbar');
    if (!navbar) return;
    const scrollThreshold = Number(navbar.dataset.scrollThreshold ?? '10');
    const sectionOffset = Number(navbar.dataset.sectionOffset ?? '120');

    const handlers: Array<() => void> = [];

    const onScroll = () => {
      if (window.scrollY > scrollThreshold) {
        navbar.classList.add('bg-base-100/80', 'shadow-sm');
        navbar.classList.remove('bg-base-100/60');
      } else {
        navbar.classList.remove('bg-base-100/80', 'shadow-sm');
        navbar.classList.add('bg-base-100/60');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    handlers.push(() => window.removeEventListener('scroll', onScroll));
    onScroll();

    const navLinks = navbar.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]');

    if (navLinks.length > 0) {
      const ids = [...navLinks].map(l => l.getAttribute('href')!.slice(1));

      const update = () => {
        const y = window.scrollY + sectionOffset;
        let current = ids[0];
        for (const id of ids) {
          const el = document.getElementById(id);
          if (el && el.offsetTop <= y) current = id;
        }
        navLinks.forEach(l => {
          if (l.getAttribute('href') === `#${current}`) {
            l.setAttribute('data-active', '');
          } else {
            l.removeAttribute('data-active');
          }
        });
      };

      window.addEventListener('scroll', update, { passive: true });
      handlers.push(() => window.removeEventListener('scroll', update));
      update();
    }

    // daisyUI dropdown stays open via focus: blur after tapping a menu item
    navbar.querySelectorAll<HTMLAnchorElement>('.dropdown a').forEach((a) => {
      a.addEventListener('click', () => {
        (document.activeElement as HTMLElement | null)?.blur();
      });
    });

    return () => handlers.forEach((off) => off());
  };

  let cleanup: (() => void) | undefined;

  const init = () => {
    cleanup = initNavbar() ?? undefined;
  };

  init();
  document.addEventListener('astro:before-swap', () => cleanup?.());
  document.addEventListener('astro:after-swap', init);
</script>
