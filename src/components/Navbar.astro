---
import { getEntry } from "astro:content";
import { Menu, Search } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";
import {
  PRIMARY_NAVIGATION,
  getHomeUrl,
  getNavigationHref,
  withBase,
} from "../config/navigation";
import { NAVBAR_SCROLL_THRESHOLD_PX, NAVBAR_SECTION_OFFSET_PX } from "../utils/constants";

const base = import.meta.env.BASE_URL;
const locale = (Astro.currentLocale ?? "ja") as Lang;
const t = useTranslations(locale);
const heroId = locale === "en" ? "en" : "index";
const heroEntry = await getEntry("hero", heroId as "index");
const name = heroEntry?.data.name ?? "Keitaro Ueki";
const { pathname } = Astro.url;

const normalizePath = (value: string) => {
  const pathOnly = value.split("#")[0].split("?")[0];
  const withSlash = pathOnly.endsWith("/") ? pathOnly : `${pathOnly}/`;
  return withSlash === "//" ? "/" : withSlash;
};

const homeUrl = getHomeUrl(locale, base);
const currentPath = normalizePath(pathname);
const isHome = currentPath === normalizePath(homeUrl);
const navItems = PRIMARY_NAVIGATION.filter(
  (item) => !item.locales || item.locales.includes(locale),
).map((item) => ({
  ...item,
  href: getNavigationHref(item, locale, base, isHome),
  label: t(item.labelKey),
}));

const isActiveHref = (href: string) => {
  if (href.startsWith("#")) return false;
  const target = normalizePath(href);
  return currentPath === target || (target !== "/" && currentPath.startsWith(target));
};

const languageHref = locale === "en" ? withBase(base) : withBase(base, "en/");
const searchHref = withBase(base, locale === "en" ? "en/search/" : "search/");
const isSearchActive = currentPath === normalizePath(searchHref);
---

<header
  id="site-navbar"
  class="site-header"
  data-scroll-threshold={NAVBAR_SCROLL_THRESHOLD_PX}
  data-section-offset={NAVBAR_SECTION_OFFSET_PX}
  data-home={isHome ? "true" : "false"}
>
  <div class="site-header__inner site-container" data-width="wide">
    <a href={homeUrl} class="site-brand" data-nav-key="brand" aria-label={`${name} — ${t("nav.home")}`}>
      <span class="site-brand__mark" aria-hidden="true"></span>
      <span class="site-brand__name">{name}</span>
    </a>

    <nav class="site-nav" aria-label={t("nav.primary")}>
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-key={item.key}
          data-section-link={isHome ? item.sectionId : undefined}
          data-active={isActiveHref(item.href) ? "" : undefined}
          aria-current={isActiveHref(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        href={languageHref}
        class="language-switch"
        data-nav-key="lang"
        aria-label={t("lang.switchLabel")}
      >
        <span>{locale === "ja" ? "English" : "日本語"}</span>
      </a>

      <a
        href={searchHref}
        class:list={["site-header__icon", isSearchActive && "is-active"]}
        data-nav-key="search"
        aria-label={t("nav.search")}
        aria-current={isSearchActive ? "page" : undefined}
      >
        <Search aria-hidden="true" />
      </a>

      <div class="dropdown dropdown-end site-menu">
        <button tabindex="0" class="site-header__icon" aria-label={t("nav.openMenu")}>
          <Menu aria-hidden="true" />
        </button>
        <ul tabindex="0" class="dropdown-content menu glass-popover rounded-box z-50 w-56 p-2 mt-3">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-key={item.key}
                class:list={[isActiveHref(item.href) && "text-primary font-semibold"]}
                aria-current={isActiveHref(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  import "../scripts/navbar";
</script>
