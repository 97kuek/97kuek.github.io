---
import { renderToString } from 'katex';
import { normalizeMathSlot } from '../utils/math';

const rawFormula = await Astro.slots.render("default");
const formula = normalizeMathSlot(rawFormula);
const html = renderToString(formula, {
  displayMode: true,
  throwOnError: false
});
---

<div class="katex-block my-8 overflow-x-auto" set:html={html} />
