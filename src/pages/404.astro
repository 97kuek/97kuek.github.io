---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal.astro";
import { House, FolderOpen } from "@lucide/astro";
import { SITE } from "../utils/site";
import { REQUEST_PATH_MAX_LENGTH } from "../utils/constants";
import { useTranslations } from "../i18n/ui";

const tJa = useTranslations("ja");
const tEn = useTranslations("en");
---

<Layout title="404 - Not Found">
  <main
    id="main-content"
    class="min-h-[calc(100svh-5rem)] flex items-center justify-center px-4 py-20"
  >
    <div class="w-full max-w-xl mx-auto">
      <Terminal title={`${SITE.terminalUser}:~ - zsh`}>
        <!-- Japanese (default) -->
        <div id="term-ja" class="term-log">
          <p><span class="prompt">{SITE.terminalUser}:~$</span> cat <span class="req-path">/...</span></p>
          <p class="err">cat: <span class="req-path">/…</span>: No such file or directory</p>
          <p class="muted">exit status 1 (404)</p>
          <p class="spacer">&nbsp;</p>
          <p class="comment"># {tJa("404.description")}</p>
          <p><span class="prompt">{SITE.terminalUser}:~$</span> <span class="cursor">|</span></p>
        </div>

        <!-- English -->
        <div id="term-en" class="term-log hidden">
          <p><span class="prompt">{SITE.terminalUser}:~$</span> cat <span class="req-path">/...</span></p>
          <p class="err">cat: <span class="req-path">/…</span>: No such file or directory</p>
          <p class="muted">exit status 1 (404)</p>
          <p class="spacer">&nbsp;</p>
          <p class="comment"># {tEn("404.description")}</p>
          <p><span class="prompt">{SITE.terminalUser}:~$</span> <span class="cursor">|</span></p>
        </div>
      </Terminal>

      <!-- Japanese actions -->
      <div id="actions-ja" class="mt-8">
        <div class="flex gap-3 justify-center flex-wrap">
          <a href={import.meta.env.BASE_URL} class="btn btn-primary btn-sm sm:btn-md gap-2">
            <House class="size-5" />
            {tJa("404.backHome")}
          </a>
          <a href={`${import.meta.env.BASE_URL}#projects`} class="btn btn-outline btn-sm sm:btn-md gap-2">
            <FolderOpen class="size-5" />
            {tJa("404.seeProjects")}
          </a>
        </div>
        <div class="flex flex-col items-center gap-3 mt-8">
          <p class="text-sm text-base-content/60">{tJa("404.also")}</p>
          <div class="flex gap-3 justify-center flex-wrap text-sm">
            <a href={`${import.meta.env.BASE_URL}blog`} class="link link-hover">{tJa("404.blog")}</a>
            <span class="text-base-content/30">&bull;</span>
            <a href={`${import.meta.env.BASE_URL}#about`} class="link link-hover">{tJa("404.about")}</a>
            <span class="text-base-content/30">&bull;</span>
            <a href={`${import.meta.env.BASE_URL}#contact`} class="link link-hover">{tJa("404.contact")}</a>
          </div>
        </div>
      </div>

      <!-- English actions -->
      <div id="actions-en" class="mt-8 hidden">
        <div class="flex gap-3 justify-center flex-wrap">
          <a href="/en/" class="btn btn-primary btn-sm sm:btn-md gap-2">
            <House class="size-5" />
            {tEn("404.backHome")}
          </a>
          <a href="/en/#projects" class="btn btn-outline btn-sm sm:btn-md gap-2">
            <FolderOpen class="size-5" />
            {tEn("404.seeProjects")}
          </a>
        </div>
        <div class="flex flex-col items-center gap-3 mt-8">
          <p class="text-sm text-base-content/60">{tEn("404.also")}</p>
          <div class="flex gap-3 justify-center flex-wrap text-sm">
            <a href="/en/#about" class="link link-hover">{tEn("404.about")}</a>
            <span class="text-base-content/30">&bull;</span>
            <a href="/en/#contact" class="link link-hover">{tEn("404.contact")}</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .term-log p {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .term-log .prompt {
    color: var(--terminal-green);
  }
  .term-log .err {
    color: var(--terminal-red);
  }
  .term-log .muted {
    color: var(--terminal-muted);
  }
  .term-log .comment {
    color: var(--terminal-muted);
  }
  .term-log .req-path {
    color: var(--terminal-text);
  }
  .term-log .spacer {
    line-height: 0.6;
  }
  .term-log .cursor {
    color: var(--terminal-text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .term-log .cursor {
      animation: term-blink 1.1s step-end infinite;
    }
  }
  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script is:inline define:vars={{ REQUEST_PATH_MAX_LENGTH }}>
  (function () {
    var isEn = window.location.pathname.replace(/^\/+/, "").startsWith("en");
    if (isEn) {
      ["term-ja", "actions-ja"].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.classList.add("hidden");
      });
      ["term-en", "actions-en"].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.classList.remove("hidden");
      });
    }
    // Show the actual requested path in the fake `cat` command.
    var path = window.location.pathname || "/";
    if (path.length > REQUEST_PATH_MAX_LENGTH) {
      path = path.slice(0, REQUEST_PATH_MAX_LENGTH - 1) + "...";
    }
    document.querySelectorAll(".req-path").forEach(function (el) {
      el.textContent = path;
    });

    // This page is a single static file built with the ja locale (Astro.currentLocale
    // can't know the visited path for a static 404 fallback), so the navbar renders
    // Japanese labels/links even when the visitor hit a broken /en/ URL. Correct it
    // client-side using the real pathname.
    if (isEn) {
      var navFixes = {
        home: { href: "/en/", text: "Home" },
        projects: { href: "/en/projects", text: "Projects" },
        contact: { href: "/en/#contact", text: "Contact" },
        search: { href: "/en/search" },
        lang: { href: "/", text: "JA", aria: "日本語に切り替え" },
        brand: { href: "/en/" },
      };
      document.querySelectorAll('[data-nav-key="blog"]').forEach(function (el) {
        el.style.display = "none";
      });
      Object.keys(navFixes).forEach(function (key) {
        var fix = navFixes[key];
        document.querySelectorAll('[data-nav-key="' + key + '"]').forEach(function (el) {
          if (fix.href) el.setAttribute("href", fix.href);
          if (fix.text) el.textContent = fix.text;
          if (fix.aria) el.setAttribute("aria-label", fix.aria);
        });
      });
    }
  })();
</script>
