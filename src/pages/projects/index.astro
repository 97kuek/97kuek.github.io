---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import FilterSection from "../../components/FilterSection.astro";
import BackLink from "../../components/BackLink.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SITE } from "../../utils/site";
import { useTranslations } from "../../i18n/ui";
import { getHomeUrl, getTagSummary, sortProjectsByDisplayDate } from "../../utils/content";
import PageShell from "../../components/layout/PageShell.astro";

const t = useTranslations("ja");

const projects = sortProjectsByDisplayDate(await getCollection("projects"));

const { tags: allSkills, tagCounts: skillCounts } = getTagSummary(
  projects,
  (project) => project.data.skills,
);
---

<Layout title={`プロジェクト - ${SITE.ownerNameJa}`} description={t("projects.metaDescription")}>
  <PageShell>
    <div class="page-backlink">
      <BackLink href={getHomeUrl("ja")} label={t("404.backHome")} />
    </div>

    <PageHeader title={t("projects.pageTitle")} description={t("projects.pageDescription")} />

    <FilterSection tags={allSkills} tagCounts={skillCounts} totalCount={projects.length} containerId="projects-grid" />

    {
      projects.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-2xl text-base-content/60">{t("projects.empty")}</p>
        </div>
      ) : (
        <div class="collection-grid" id="projects-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </PageShell>
</Layout>
