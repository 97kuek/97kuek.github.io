---
import { getEntry, getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { getProjectNav } from "../../utils/content";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

// Get the slug from params and fetch the entry
const { slug } = Astro.params;

// Handle the slug
const entry = await getEntry("projects", slug as string);

// If entry doesn't exist, return 404
if (!entry) {
  return Astro.redirect(`${import.meta.env.BASE_URL}404`);
}

const { Content, headings } = await render(entry);

const allProjects = await getCollection("projects");
const { prev: prevNav, next: nextNav } = getProjectNav(allProjects, entry.id, "ja");
---

<ProjectLayout
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  startDate={entry.data.startDate}
  endDate={entry.data.endDate}
  image={entry.data.image}
  images={entry.data.images}
  skills={entry.data.skills}
  demoLink={entry.data.demoLink}
  sourceLink={entry.data.sourceLink}
  updatedDate={entry.data.updatedDate}
  headings={headings}
  prev={prevNav}
  next={nextNav}
>
  <Content />
</ProjectLayout>
