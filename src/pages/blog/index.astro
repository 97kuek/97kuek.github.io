---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import FilterSection from "../../components/FilterSection.astro";
import BackLink from "../../components/BackLink.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SITE } from "../../utils/site";
import { useTranslations } from "../../i18n/ui";
import { getHomeUrl, getTagSummary } from "../../utils/content";
import { getExternalArticles } from "../../utils/externalArticles";
import PageShell from "../../components/layout/PageShell.astro";

const t = useTranslations("ja");

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const externalArticles = await getExternalArticles();
const articleItems = [
  ...posts.map((post) => ({ type: "local" as const, date: post.data.publishDate, post })),
  ...externalArticles.map((article) => ({ type: "external" as const, date: article.publishedAt, article })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const { tags: allTags, tagCounts } = getTagSummary(
  [...posts, ...externalArticles],
  (item) => "source" in item ? item.tags : item.data.tags,
);
---

<Layout title={`ブログ - ${SITE.ownerNameJa}`} description={t("blog.metaDescription")}>
  <PageShell>
    <div class="page-backlink">
      <BackLink href={getHomeUrl("ja")} label={t("404.backHome")} />
    </div>

    <PageHeader title={t("blog.pageTitle")} description={t("blog.pageDescription")} />

    <FilterSection tags={allTags} tagCounts={tagCounts} totalCount={articleItems.length} containerId="blog-grid" />

    {
      articleItems.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-2xl text-base-content/60">{t("blog.empty")}</p>
        </div>
      ) : (
        <div class="collection-grid" id="blog-grid">
          {articleItems.map((item) => (
            item.type === "local"
              ? <BlogCard post={item.post} headingLevel="h2" />
              : <BlogCard article={item.article} headingLevel="h2" />
          ))}
        </div>
      )
    }
  </PageShell>
</Layout>
