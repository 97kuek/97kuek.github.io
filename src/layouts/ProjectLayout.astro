---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Carousel from "../components/Carousel.astro";
import SkillBadge from "../components/SkillBadge.astro";
import { ExternalLink } from "@lucide/astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import { formatDate, formatPeriod } from "../utils/formatDate";
import { useTranslations, type Lang } from "../i18n/ui";
import RelatedContent from "../components/RelatedContent.astro";
import PrevNextNav from "../components/PrevNextNav.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import BackToTop from "../components/BackToTop.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { SITE } from "../utils/site";
import BackLink from "../components/BackLink.astro";
import ContentHeader from "../components/ContentHeader.astro";
import {
  CONTENT_IMAGE_HEIGHT,
  CONTENT_IMAGE_WIDTH,
  PROJECT_CAROUSEL_INTERVAL_MS,
  PROJECT_IMAGE_HEIGHT,
} from "../utils/constants";

interface NavEntry {
  title: string;
  description: string;
  url: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  image?: ImageMetadata;
  images?: ImageMetadata[];
  skills: string[];
  role?: string;
  impact?: string;
  status?: string;
  demoLink?: string;
  sourceLink?: string;
  updatedDate?: Date;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: NavEntry;
  next?: NavEntry;
}

const {
  id,
  title,
  description,
  startDate,
  endDate,
  image,
  images,
  skills,
  role,
  impact,
  status,
  demoLink,
  sourceLink,
  updatedDate,
  headings = [],
  prev,
  next,
} = Astro.props;

const locale = (Astro.currentLocale ?? "ja") as Lang;
const isEn = locale === "en";
const t = useTranslations(locale);
const projectsListUrl = isEn
  ? `${import.meta.env.BASE_URL}en/projects`
  : `${import.meta.env.BASE_URL}projects`;
const dateLocale = t("timeline.dateLocale");

// Includes ongoing projects, unlike the utility used for completed date ranges.
function calculateProjectDuration(startDate: Date, endDate?: Date) {
  const end = endDate || new Date();
  const months =
    (end.getFullYear() - startDate.getFullYear()) * 12 +
    (end.getMonth() - startDate.getMonth());

  if (months < 1) return isEn ? "less than a month" : "1ヶ月未満";
  if (months < 12) return isEn ? `${months} mo` : `${months}ヶ月`;

  const years = Math.floor(months / 12);
  const remainingMonths = months % 12;

  if (remainingMonths === 0) return isEn ? `${years} yr` : `${years}年`;
  return isEn ? `${years} yr ${remainingMonths} mo` : `${years}年${remainingMonths}ヶ月`;
}

const hasToc = headings.some((h) => h.depth <= 3);

const ogImage = image
  ? `${Astro.url.origin}${typeof image === "object" && "src" in image ? image.src : image}`
  : `${Astro.url.origin}${import.meta.env.BASE_URL}og/projects/${id}.png`;

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": title,
  "description": description,
  "dateCreated": startDate.toISOString(),
  ...(endDate ? { "dateModified": endDate.toISOString() } : {}),
  "author": { "@type": "Person", "name": SITE.ownerName, "url": Astro.url.origin },
  "url": Astro.url.href,
  "image": ogImage,
  ...(skills && skills.length > 0 ? { "keywords": skills.join(", ") } : {}),
};
---

<Layout
  title={`${title} - ${isEn ? SITE.ownerName : SITE.ownerNameJa}`}
  description={description}
  ogImage={ogImage}
  ogImageWidth={800}
  ogImageHeight={450}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  </Fragment>
  <ReadingProgress />
  <BackToTop />

  <main id="main-content" class="max-w-6xl mx-auto px-4 pt-20 pb-16">
    <div class="mb-8">
      <BackLink href={projectsListUrl} label={t("project.backToList")} class="btn btn-soft btn-sm" />
    </div>

    <div class:list={[hasToc && "lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12 xl:gap-16"]}>
      <article class="min-w-0">
        <div class="max-w-3xl mx-auto">
          {
            ((images && images.length > 1) || image) && (
              <figure class="mb-8 rounded-lg overflow-hidden border border-base-200">
                {images && images.length > 1 ? (
                  <Carousel interval={PROJECT_CAROUSEL_INTERVAL_MS}>
                    {images.map((img) => (
                      <div class="carousel-slide flex-shrink-0 aspect-video">
                        <Image
                          src={img}
                          alt={title}
                          class="w-full h-full object-cover"
                          width={CONTENT_IMAGE_WIDTH}
                          height={PROJECT_IMAGE_HEIGHT}
                        />
                      </div>
                    ))}
                  </Carousel>
                ) : image ? (
                  <Image
                    src={image}
                    alt={title}
                    class="w-full aspect-video object-cover"
                    width={CONTENT_IMAGE_WIDTH}
                    height={CONTENT_IMAGE_HEIGHT}
                  />
                ) : null}
              </figure>
            )
          }

          <ContentHeader eyebrow="PROJECT" title={title} description={description}>
            <div class="flex flex-wrap items-center gap-4 text-sm text-base-content/60 mb-6">
              <span class="font-semibold">
                {formatPeriod(startDate, endDate, dateLocale, t("timeline.present"))}
              </span>
              <span>&bull;</span>
              <span>{t("project.duration")}: {calculateProjectDuration(startDate, endDate)}</span>
              {
                !endDate && (
                  <>
                    <span>&bull;</span>
                    <span class="badge badge-success badge-sm">{t("project.ongoing")}</span>
                  </>
                )
              }
              {
                updatedDate && (
                  <>
                    <span>&bull;</span>
                    <span>{t("project.lastUpdated")}: {formatDate(updatedDate, dateLocale)}</span>
                  </>
                )
              }
            </div>

            {
              (demoLink || sourceLink) && (
                <div class="flex flex-wrap gap-3">
                  {demoLink && (
                    <a
                      href={demoLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-primary gap-2"
                    >
                      <ExternalLink class="size-5" />
                      {t("project.viewDemo")}
                    </a>
                  )}
                  {sourceLink && (
                    <a
                      href={sourceLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-soft gap-2"
                    >
                      <GitHubIcon class="size-5" aria-hidden="true" />
                      {t("project.sourceCode")}
                    </a>
                  )}
                </div>
              )
            }
          </ContentHeader>

          {
            (role || impact || status) && (
              <section class="border border-base-200 bg-base-100 rounded-lg p-6 mb-8">
                <h2 class="text-sm font-bold tracking-widest text-primary uppercase mb-4">
                  {t("project.overview")}
                </h2>
                <dl class="grid gap-4 sm:grid-cols-3">
                  {role && (
                    <div>
                      <dt class="text-xs font-bold tracking-widest uppercase text-base-content/50">
                        {t("project.role")}
                      </dt>
                      <dd class="mt-1 text-sm font-semibold text-base-content">{role}</dd>
                    </div>
                  )}
                  {impact && (
                    <div>
                      <dt class="text-xs font-bold tracking-widest uppercase text-base-content/50">
                        {t("project.impact")}
                      </dt>
                      <dd class="mt-1 text-sm font-semibold text-base-content">{impact}</dd>
                    </div>
                  )}
                  {status && (
                    <div>
                      <dt class="text-xs font-bold tracking-widest uppercase text-base-content/50">
                        {t("project.status")}
                      </dt>
                      <dd class="mt-1 text-sm font-semibold text-base-content">{status}</dd>
                    </div>
                  )}
                </dl>
              </section>
            )
          }

          {
            skills && skills.length > 0 && (
              <section class="border border-base-200 bg-base-100 rounded-lg p-6 mb-8">
                <h2 class="text-sm font-bold tracking-widest text-primary uppercase mb-4">
                  {t("project.techStack")}
                </h2>
                <div class="flex flex-wrap gap-2">
                  {skills.map((skill) => (
                    <SkillBadge
                      skill={skill}
                      href={`${projectsListUrl}?tag=${encodeURIComponent(skill.toLowerCase())}`}
                    />
                  ))}
                </div>
              </section>
            )
          }

          <div class="divider"></div>

          {hasToc && (
            <div class="mb-8 lg:hidden">
              <TableOfContents headings={headings} />
            </div>
          )}

          <div class="prose max-w-none prose-headings:text-primary prose-h2:border-b-2 prose-h2:border-primary prose-h2:pb-2 prose-h3:border-l-4 prose-h3:border-primary prose-h3:pl-3 prose-img:mx-auto prose-img:block prose-img:max-w-full sm:prose-img:max-w-2xl prose-img:rounded-lg">
            <slot />
          </div>

          <PrevNextNav prev={prev} next={next} collection="projects" />

          <RelatedContent
            currentId={id}
            collection="projects"
            tags={skills}
          />

          <div class="divider mt-12"></div>

          <div class="text-center mt-8">
            <a href={projectsListUrl} class="btn btn-primary">
              {t("project.seeAllBottom")}
            </a>
          </div>
        </div>
      </article>

      {
        hasToc && (
          <aside class="hidden lg:block">
            <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto overscroll-contain pb-4">
              <TableOfContents headings={headings} sidebar={true} />
            </div>
          </aside>
        )
      }
    </div>
  </main>
</Layout>
